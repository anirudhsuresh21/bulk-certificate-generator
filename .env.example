# ==============================================================
# Common Environment Configuration Template
# Copy this file to .env and configure your values.
# ==============================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/bulk-certi

# Frontend Configuration (Variables prefixed with NEXT_PUBLIC_ are accessible in browser)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Email / SMTP Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="CertiCraft <no-reply@certicraft.com>"
